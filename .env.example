# x-copilot configuration — copy to .env and adjust. All values are optional;
# these are the defaults. Nothing here is secret (the whole loop is local).

# Local LLM (Ollama) — must be running: `ollama serve`, and the model pulled:
# `ollama pull llama3.1`. The model must support tool-calling.
OLLAMA_BASE_URL=http://127.0.0.1:11434
XCOPILOT_MODEL=llama3.1

# X-Plane 12 Web API (enable it in X-Plane: Settings → Network → Web API).
XPLANE_BASE_URL=http://127.0.0.1:8086

# whisper.cpp model (download a ggml .bin, e.g. ggml-base.en.bin).
WHISPER_MODEL=models/ggml-base.en.bin

# Capture mode: `continuous` (always listening, requires a wake word) or `ptt`
# (push-to-talk, Enter to start/stop).
XCOPILOT_LISTEN=continuous
# Wake word required to act in continuous mode. Empty (default) = act on every
# clear utterance and let the LLM ignore non-commands. Set e.g. `copilot` to
# require a prefix (fuzzy-matched, tolerant of STT errors like "go pilot").
XCOPILOT_WAKE_WORD=
# VAD energy threshold (RMS). Raise in a noisy room; lower if quiet speech is missed.
XCOPILOT_VAD_RMS=0.012
# Minimum STT confidence (mean token probability, 0..1) to act on a command.
# Below this it asks you to say it again. Clear commands score ~0.8. Raise to be
# stricter (fewer misfires), lower if good commands get rejected.
XCOPILOT_STT_MIN_CONFIDENCE=0.5

# TTS backend: `say` (macOS built-in, default, zero install) or `piper`.
XCOPILOT_TTS=say

# piper TTS — only used when XCOPILOT_TTS=piper. Binary on PATH + a voice .onnx
# (with its .onnx.json beside it). Note: prebuilt macOS piper binaries are often
# broken; `say` is the reliable default on macOS.
PIPER_BIN=piper
PIPER_VOICE=models/en_US-amy-medium.onnx

# Aircraft profile. `auto` detects it from X-Plane's acf_ICAO and loads
# profiles/<id>.yaml; or set an explicit id (e.g. cessna_172sp) to force one.
XCOPILOT_AIRCRAFT=auto

# Require a spoken "affirm" before executing safety-critical commands (autopilot
# heading/altitude/vertical-speed). Strongly recommended. Set to false to skip.
XCOPILOT_CONFIRM=true

# Optional: log level, e.g. x_copilot=debug
# RUST_LOG=x_copilot=info
