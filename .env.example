# x-copilot configuration — copy to .env and adjust. All values are optional;
# these are the defaults. Nothing here is secret (the whole loop is local).

# Local LLM (Ollama) — must be running: `ollama serve`, and the model pulled:
# `ollama pull qwen3:8b`. The model must support tool-calling. qwen3:8b won the
# tool-pick battery (100% on the clean command set, fastest of the perfect
# scorers); its thinking mode is auto-disabled in code for low latency.
OLLAMA_BASE_URL=http://127.0.0.1:11434
XCOPILOT_MODEL=qwen3:8b

# How long Ollama keeps the model resident (on the GPU) after a command. The
# default holds ~5GB of GPU memory the whole flight to avoid cold-load latency;
# set a short value (e.g. 30s) or 0 to free that memory between commands for a
# GPU-bound X-Plane, at the cost of a reload (a few seconds) on the next command.
# XCOPILOT_LLM_KEEPALIVE=60m

# X-Plane 12 Web API (enable it in X-Plane: Settings → Network → Web API).
XPLANE_BASE_URL=http://127.0.0.1:8086

# whisper.cpp model (download a ggml .bin). Bigger = more accurate but heavier on
# the GPU — `large-v3-turbo` is most accurate, `small.en`/`base.en` are far
# lighter. If X-Plane FPS drops when you speak, prefer a smaller model here.
WHISPER_MODEL=models/ggml-base.en.bin

# Run whisper on the Metal GPU (true, default) or the CPU (false). The GPU is
# fastest, but it competes with a GPU-bound X-Plane — set false to push STT onto
# the CPU (which has headroom) and stop the per-command FPS dip.
# XCOPILOT_WHISPER_GPU=false

# Capture mode: `continuous` (always listening, requires a wake word) or `ptt`
# (push-to-talk, Enter to start/stop).
XCOPILOT_LISTEN=continuous
# Wake word required to act in continuous mode. Empty (default) = act on every
# clear utterance and let the LLM ignore non-commands. Set e.g. `copilot` to
# require a prefix (fuzzy-matched, tolerant of STT errors like "go pilot").
XCOPILOT_WAKE_WORD=
# VAD energy threshold (RMS). Raise in a noisy room; lower if quiet speech is missed.
XCOPILOT_VAD_RMS=0.012
# Minimum STT confidence (mean token probability, 0..1) to act on a command.
# Below this it asks you to say it again. Clear commands score ~0.8. Raise to be
# stricter (fewer misfires), lower if good commands get rejected.
XCOPILOT_STT_MIN_CONFIDENCE=0.5
# Trailing silence (ms) that ends an utterance in continuous mode. Raise it if a
# slight mid-command hesitation cuts you off; lower it for snappier turn-taking.
XCOPILOT_END_SILENCE_MS=900

# UI: `tui` (terminal dashboard: conversation log, live aircraft panel, mic
# meter) or `plain` (stdout). Unset = auto: `tui` on an interactive terminal,
# `plain` when piped/redirected. TUI is best with continuous listen mode.
# XCOPILOT_UI=tui

# TTS backend: `sidecar` (warm Spark voice-clone "Roger" — the default; auto-
# spawned, falls back to `say` if it can't start), `say` (macOS built-in, zero
# install), `piper`, or `onnx` (feature onnx-tts). Unset = sidecar.
# XCOPILOT_TTS=say

# macOS `say` voice + rate (only used when XCOPILOT_TTS=say). List voices with
#   say -v '?'        (preview one:  say -v Daniel "Roger, flaps ten")
# Empty voice = system default; rate is words/min (~175 default).
# XCOPILOT_SAY_VOICE=Daniel
# XCOPILOT_SAY_RATE=180

# Spark sidecar (XCOPILOT_TTS=sidecar). Auto-spawned and supervised by default;
# set AUTOSPAWN=false to talk to one you started by hand. PYTHON empty = discover
# an mlx-audio venv (e.g. /tmp/mlxtts/bin/python). READY_SECS bounds the wait for
# the model to load before falling back to `say` (a first run downloads it).
XCOPILOT_TTS_SIDECAR_URL=http://127.0.0.1:8765/synth
# XCOPILOT_TTS_SIDECAR_AUTOSPAWN=true
# XCOPILOT_TTS_SIDECAR_PYTHON=/tmp/mlxtts/bin/python
# XCOPILOT_TTS_SIDECAR_READY_SECS=90
# Spark sampling temperature (0..1): higher = livelier/more varied, lower =
# flatter/more monotone. Default 0.7 (0.6 droned; 0.8 drifted/leaked the ref).
# XCOPILOT_TTS_SIDECAR_TEMP=0.7

# Default cloned voice (a name under voice/voices/). Empty = the sidecar's own
# default (its .active file, set by `voice/voices.py use <name>`, else `roger`).
# Manage voices with `voice/voices.py` (list / use / add --mic / add --file).
# XCOPILOT_VOICE=roger

# piper TTS — only used when XCOPILOT_TTS=piper. Binary on PATH + a voice .onnx
# (with its .onnx.json beside it). Note: prebuilt macOS piper binaries are often
# broken; `say` is the reliable fallback on macOS.
PIPER_BIN=piper
PIPER_VOICE=models/en_US-amy-medium.onnx

# Aircraft profile. `auto` detects it from X-Plane's acf_ICAO and loads
# profiles/<id>.yaml; or set an explicit id (e.g. cessna_172sp) to force one.
XCOPILOT_AIRCRAFT=auto

# Require a spoken "affirm" before executing safety-critical commands (autopilot
# heading/altitude/vertical-speed). Strongly recommended. Set to false to skip.
XCOPILOT_CONFIRM=true

# Optional: log level, e.g. x_copilot=debug
# RUST_LOG=x_copilot=info
